# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# LLM Provider (groq is free and fast)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Ollama (local, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# NVD API (optional, for CVE lookups - free key at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Reporting
REPORT_OUTPUT_DIR=./results

# ── OSINT Sources (all optional — RAO works without any) ──────────────────────

# Shodan: Internet exposure data (free key at https://account.shodan.io)
SHODAN_API_KEY=

# VirusTotal: Subdomain enum + threat intel (free key at https://virustotal.com)
VT_API_KEY=

# SecurityTrails: Subdomain history (free at https://securitytrails.com/corp/api)
SECURITYTRAILS_API_KEY=

# Hunter.io: Corporate email discovery (free 25 req/month at https://hunter.io)
HUNTER_API_KEY=

# GitHub: Code search for leaks (optional — without token: 10 req/min)
GITHUB_TOKEN=
