# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# LLM Provider (groq is free and fast)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Ollama (local, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# NVD API (optional, for CVE lookups - free key at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Reporting
REPORT_OUTPUT_DIR=./results
